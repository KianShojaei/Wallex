# ---- Wallex (challenge account) ----
WALLEX_API_KEY=                        # Wallex panel > API management (header X-API-Key). Trade permission only, NO withdrawal.
WALLEX_BASE_URL=https://api.wallex.ir

# ---- AI gateway (OpenAI-compatible, provided by the hackathon) ----
AI_BASE_URL=https://ai.boxapi.ir/ai/v1
AI_API_KEY=
AI_MODEL_FAST=openai/gpt-6-luna        # per-candidate sizing decisions (cheap, ~1-8s)
AI_MODEL_DEEP=openai/gpt-6-sol         # hourly regime analysis

# ---- Run ----
RUN_MODE=shadow                        # shadow | live
CONFIG_PATH=config/settings.yaml
DASHBOARD_TOKEN=                       # locks the web dashboard and the /mcp endpoint (?token=... or header X-Token)
PORT=8000
# DATA_DIR=/app/data                   # containers: one persistent disk for state, decision logs, AI cache and candles
