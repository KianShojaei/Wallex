# ---- Wallex ----
WALLEX_API_KEY=            # from Wallex panel > API management (header X-API-Key)
WALLEX_BASE_URL=https://api.wallex.ir

# ---- AI gateway (OpenAI-compatible, provided by hackathon) ----
AI_BASE_URL=https://ai.boxapi.ir/ai/v1
AI_API_KEY=
AI_MODEL_FAST=openai/gpt-6-luna      # per-signal decisions (cheap, ~0.5s)
AI_MODEL_DEEP=openai/gpt-6-sol       # hourly regime analysis

# ---- Run ----
RUN_MODE=shadow                       # shadow | live | backtest
CONFIG_PATH=config/settings.yaml
